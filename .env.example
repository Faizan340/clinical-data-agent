# Copy to .env and paste your key. Get a free key at https://aistudio.google.com/apikey
# Keep billing DISABLED on that Google project to stay on the free tier.
GEMINI_API_KEY=
# Each model has its own free-tier quota. If one runs out, try another (e.g. gemini-3.1-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Free tier: requests per minute are limited (5/min seen for gemini-2.5-flash), so calls are spaced out.
LLM_MIN_INTERVAL_S=13

# Cache LLM responses on disk (evals always use the cache unless --no-cache)
LLM_CACHE=false

# Harness limits (per question)
MAX_LLM_CALLS=6
MAX_SQL_ATTEMPTS=3
MAX_ROWS=200

ADMIN_DB_URL=postgresql://admin:admin@localhost:5440/clinical
AGENT_DB_URL=postgresql://analyst_ro:analyst_ro@localhost:5440/clinical
REDIS_URL=redis://localhost:6390/0
